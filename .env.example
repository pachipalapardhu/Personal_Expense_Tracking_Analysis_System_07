# Local development only. Copy to .env and fill in your own values.
# Never commit .env or put real passwords in this file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=defaultdb
MYSQL_USE_SSL=false
MYSQL_SSL_CA=
MYSQL_SSL_DISABLED=false

# Generate a unique value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret

# Optional: required only for email OTP registration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_FROM=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
